{
  "name": "@antnexo/react-native",
  "version": "1.0.0",
  "description": "AntNexo in your React Native app: feedback, roadmap and What's new in a native sheet",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "antnexo-react-native-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*",
    "vendor.json"
  ],
  "scripts": {
    "example": "yarn workspace @antnexo/react-native-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "feedback",
    "roadmap",
    "changelog",
    "antnexo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntNexo/antnexo-react-native.git"
  },
  "author": "AntNexo <hello@antnexo.com> (https://antnexo.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AntNexo/antnexo-react-native/issues"
  },
  "homepage": "https://github.com/AntNexo/antnexo-react-native#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.0",
    "del-cli": "^8.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "30.5.2",
    "prettier": "^3.9.10",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-builder-bob": "^0.44.1",
    "test-renderer": "^1.0.0",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.81"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.18.1",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "AntNexoSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.antnexo.reactnative"
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "tools": [
      "eslint",
      "jest"
    ],
    "version": "0.64.0"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/example/"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
